<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.yukkes.jvmeter</groupId>
    <artifactId>jvmeter-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>jvmeter-gui</artifactId>
  <name>jvmeter GUI</name>

  <dependencies>
    <dependency>
      <groupId>io.github.yukkes.jvmeter</groupId>
      <artifactId>jvmeter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.avaje</groupId>
      <artifactId>avaje-jsonb-generator</artifactId>
      <scope>provided</scope>
      <optional>true</optional>
    </dependency>
    <!-- built first, and bundled (below): the GUI runs and loads it where the JVM runs -->
    <dependency>
      <groupId>io.github.yukkes.jvmeter</groupId>
      <artifactId>jvmeter-agent</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <!-- target/jvmeter-gui.jar: one runnable jar (core + FlatLaf) -->
    <finalName>jvmeter-gui</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>bundle-agent</id>
            <phase>prepare-package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.github.yukkes.jvmeter</groupId>
                  <artifactId>jvmeter-agent</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.outputDirectory}/jvmeter/gui</outputDirectory>
                  <destFileName>jvmeter-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>jvmeter.gui.Main</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <!-- merge META-INF/services (avaje-jsonb's generated components in core and gui) -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>com.formdev:flatlaf</artifact>
                  <excludes>
                    <!-- native window decorations only; Swing works without them and the jar stays small -->
                    <exclude>com/formdev/flatlaf/natives/**</exclude>
                    <exclude>META-INF/*.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
